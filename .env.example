# ============================================
# TG-SignPulse - 环境变量示例
# 本项目已归档，仅供技术学习参考
# ============================================

# 应用密钥（本地开发用）
APP_SECRET_KEY=your_secret_key_here

# 后端监听端口（默认 8080，与前端 Vite 代理一致）
APP_PORT=8080

# 前端开发服务器地址（未构建前端时，后端会把非 API 请求重定向到这里）
FRONTEND_DEV_SERVER_URL=http://127.0.0.1:5173

# 前端构建产物目录（默认 <项目根>/frontend/dist）
# APP_WEB_DIR=/path/to/frontend/dist

# 数据目录
APP_DATA_DIR=/data
