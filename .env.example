# ============================================
# TG-SignPulse - 环境变量示例
# 本项目已归档，仅供技术学习参考
# ============================================

# 应用密钥（必填：至少 32 字符的随机值，生成：openssl rand -hex 32）
# 注意：留空或使用弱值（如 your_secret_key）会导致应用拒绝启动；
# 未设置时会自动生成并持久化到数据目录下的 .app_secret_key。
APP_SECRET_KEY=

# 后端监听端口（默认 8080，与前端 Vite 代理一致）
APP_PORT=8080

# 前端开发服务器地址（未构建前端时，后端会把非 API 请求重定向到这里）
FRONTEND_DEV_SERVER_URL=http://127.0.0.1:5173

# 前端构建产物目录（默认 <项目根>/frontend/dist）
# APP_WEB_DIR=/path/to/frontend/dist

# 数据目录
APP_DATA_DIR=/data
